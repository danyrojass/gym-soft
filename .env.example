# App
NODE_ENV=development
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=change-me-to-a-long-random-secret

# Database (Docker Compose defaults)
POSTGRES_USER=gymsoft
POSTGRES_PASSWORD=gymsoft
POSTGRES_DB=gymsoft
POSTGRES_PORT=5434
# Local Docker: misma URL para runtime y migraciones
DATABASE_URL="postgresql://gymsoft:gymsoft@127.0.0.1:5434/gymsoft?schema=public"
DIRECT_URL="postgresql://gymsoft:gymsoft@127.0.0.1:5434/gymsoft?schema=public"

# Vercel/Neon ejemplo:
# DATABASE_URL="postgresql://USER:PASSWORD@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require"   # pooled (app)
# DIRECT_URL="postgresql://USER:PASSWORD@ep-xxx.region.aws.neon.tech/neondb?sslmode=require"             # direct (migrate)

# Seed (default staff bootstrap)
SEED_GYM_NAME="Gimnasio Principal"
SEED_ADMIN_EMAIL=admin@gym.local
SEED_ADMIN_PASSWORD=Admin12345!
SEED_ADMIN_NAME="Administrador"
SEED_RECEPCION_EMAIL=recepcion@gym.local
SEED_RECEPCION_PASSWORD=Recepcion12345!
SEED_RECEPCION_NAME="Recepción"

# Gym defaults
GYM_TIMEZONE=America/Argentina/Buenos_Aires
